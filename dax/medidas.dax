// =====================================================================
// Medidas do modelo, agrupadas pelas pastas de exibição da tabela "Medidas".
// A pasta de cada grupo está indicada no cabeçalho (use "\" para subpastas).
// =====================================================================


// ---------------------------------------------------------------------
// Pasta: 01 KPIs
// ---------------------------------------------------------------------

Total de produtos = DISTINCTCOUNT(dProdutos[product_id])

Total de avaliações = SUM(dProdutos[rating_count])

// Média simples das notas dos produtos (cada produto pesa igual)
Nota média = AVERAGE(dProdutos[rating])

// Diferença média entre preço original e preço com desconto, em US$
Desconto médio (US$) =
AVERAGEX(
    dProdutos,
    dProdutos[actual_price_dollar] - dProdutos[discounted_price_dollar]
)

Desconto médio (%) = AVERAGE(dProdutos[discount_percentage])


// ---------------------------------------------------------------------
// Pasta: 02 Engajamento
// ---------------------------------------------------------------------

Média de avaliações = AVERAGE(dProdutos[rating_count])

// Preferida à média: a distribuição de rating_count tem cauda muito longa
Mediana de avaliações = MEDIAN(dProdutos[rating_count])


// ---------------------------------------------------------------------
// Pasta: 03 Concentração e quadrantes
// ---------------------------------------------------------------------

// Curva de Pareto por categoria. O denominador ignora os filtros (ALL), então
// o percentual é sempre sobre o total de avaliações do portfólio.
% acumulado de avaliações =
VAR QtdAtual = [Total de avaliações]
VAR Acumulado =
    SUMX(
        FILTER(
            ALLSELECTED(dProdutos[categoria_principal]),
            [Total de avaliações] >= QtdAtual
        ),
        [Total de avaliações]
    )
RETURN
    DIVIDE(Acumulado, CALCULATE([Total de avaliações], ALL(dProdutos)))

// Participação da seleção no portfólio, ignorando só o filtro de quadrante
% do portfólio =
DIVIDE(
    [Total de produtos],
    CALCULATE([Total de produtos], REMOVEFILTERS(dProdutos[quadrante]))
)


// ---------------------------------------------------------------------
// Pasta: 04 Customer Insights\Base
// ---------------------------------------------------------------------

Menções = SUM(dPalavras[qtd])

Produtos com menção = DISTINCTCOUNT(dPalavras[product_id])

// Equivale a [Total de produtos] no contexto da dProdutos
Produtos na seleção = COUNTROWS(dProdutos)


// ---------------------------------------------------------------------
// Pasta: 04 Customer Insights\Temas
// ---------------------------------------------------------------------

% Produtos que mencionam = DIVIDE([Produtos com menção], [Produtos na seleção])

Menções por produto = DIVIDE([Menções], [Produtos na seleção])


// ---------------------------------------------------------------------
// Pasta: 04 Customer Insights\Bons vs ruins
// ---------------------------------------------------------------------

% Produtos Bom = CALCULATE([% Produtos que mencionam], dProdutos[grupo_nota] = "Bom")

% Produtos Ruim = CALCULATE([% Produtos que mencionam], dProdutos[grupo_nota] = "Ruim")

Mais em Bom (p.p.) = ([% Produtos Bom] - [% Produtos Ruim]) * 100

Mais em Ruim (p.p.) = ([% Produtos Ruim] - [% Produtos Bom]) * 100


// =====================================================================
// Colunas calculadas (dProdutos)
// =====================================================================

grupo_nota =
VAR nota = dProdutos[rating]
RETURN
    IF(
        ISBLANK(nota),
        BLANK(),
        SWITCH(
            TRUE(),
            nota <= 3.9, "Ruim",
            nota > 4.2, "Bom",
            "Intermediário"
        )
    )

// Usada na tabela de consulta do Portfólio (se existir no modelo)
nome_curto =
VAR t = TRIM(dProdutos[product_name])
VAR pos = SEARCH("|", t, 1, 0)
VAR antes = TRIM(IF(pos > 0, LEFT(t, pos - 1), t))
VAR limite = 50
RETURN
    IF(LEN(antes) > limite, TRIM(LEFT(antes, limite)) & "…", antes)

// Quadrantes: cruzam nota e engajamento pelas MEDIANAS do portfólio (nota 4,1; rating_count 4.740).
// Valores em branco são tratados como zero pelo DAX: o produto sem nota válida (B08L12N5H1) e o
// produto sem rating_count (B0B94JPY2N) caem em "Atenção"; o sem rating_count com nota 5,0
// (B0BQRJ3C47) cai em "Oportunidade".
quadrante =
VAR MedNota = MEDIAN ( dProdutos[rating] )
VAR MedAval = MEDIAN ( dProdutos[rating_count] )
RETURN
    SWITCH (
        TRUE (),
        dProdutos[rating] >= MedNota && dProdutos[rating_count] >= MedAval, "Estrela",
        dProdutos[rating] <  MedNota && dProdutos[rating_count] >= MedAval, "Risco",
        dProdutos[rating] >= MedNota, "Oportunidade",
        "Atenção"
    )

// Observação: actual_price_dollar e discounted_price_dollar NÃO são colunas DAX. São criadas no
// Power Query (dProdutos), multiplicando actual_price_rupia e discounted_price_rupia pelo
// parâmetro TaxaINRUSD.
